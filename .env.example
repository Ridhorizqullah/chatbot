# ==========================================
# TANIPINTAR BOT CONFIGURATION ENVIRONMENT
# ==========================================

# Server App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Supabase Credentials (PostgreSQL, pgvector, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=crop-symptoms

# Weather API (WeatherAPI.com)
WEATHER_API_KEY=your_weatherapi_key_here

# WhatsApp Cloud API (Meta Graph API - Optional Enterprise Gateway)
META_WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WA_ACCESS_TOKEN=your_permanent_or_system_user_token
META_WA_VERIFY_TOKEN=tanipintar_webhook_verify_token_secret
META_GRAPH_VERSION=v20.0

# WhatsApp Provider (waha atau meta)
WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default

# Guardrail & Admin Security
CONFIDENCE_THRESHOLD=0.70
ADMIN_API_KEY=your_secure_admin_api_key_here

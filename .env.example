# ==========================================
# TANIPINTAR BOT CONFIGURATION ENVIRONMENT
# ==========================================

# Server App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Cadangan LLM teks: Tencent Cloud TokenHub (opsional, dipakai jika Gemini gagal / kena limit)
TOKENHUB_API_KEY=your_tokenhub_api_key_here
TOKENHUB_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
TOKENHUB_MODELS=hy4,deepseek-v4.1-flash

# Supabase Credentials (PostgreSQL, pgvector, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=crop-symptoms

# Weather API (WeatherAPI.com)
WEATHER_API_KEY=your_weatherapi_key_here

# WhatsApp Cloud API (Meta Graph API - Optional Enterprise Gateway)
META_WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WA_ACCESS_TOKEN=your_permanent_or_system_user_token
META_WA_VERIFY_TOKEN=tanipintar_webhook_verify_token_secret
META_GRAPH_VERSION=v20.0
# App Secret Meta (wajib jika WHATSAPP_PROVIDER=meta, untuk verifikasi X-Hub-Signature-256)
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Provider (waha atau meta)
WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=your_waha_api_key_secret_here
WAHA_HMAC_SECRET=your_waha_webhook_hmac_secret_here
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_dashboard_password_here
WAHA_HUMAN_DELAY_SECONDS=1.5

# Redis Distributed Cache & De-duplication (Optional)
REDIS_URL=redis://localhost:6379/0

# Guardrail & Admin Security
CONFIDENCE_THRESHOLD=0.70
# WAJIB diisi string acak panjang (contoh: openssl rand -hex 32). Kosong = endpoint admin terkunci.
ADMIN_API_KEY=your_secure_admin_api_key_here
